# Copy this file to .env. Never commit .env or put a real key in this example file.
# Everything is optional: with no key and no local model the app runs in Demo mode.

# --- Cloud AI (Google Gemini). Get your own key from Google AI Studio. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Local AI (Ollama): install Ollama, then run `ollama pull llama3.2:1b` ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# auto = Gemini, then Ollama, then Demo | gemini | ollama | simulated
AI_MODE=auto

# --- Speech ---
# Language for browser speech recognition and read-aloud.
SPEECH_LANG=en-GB
# Download the offline Vosk model in the background at start-up (true/false).
PRELOAD_SPEECH_MODEL=true

# --- Limits and server ---
RATE_LIMIT_PER_MINUTE=20
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
